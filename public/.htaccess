Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteRule ^products/?$ /index.html [L]
RewriteRule ^products/(?!.*\.(jpg|jpeg|png|webp|gif|svg|ico)$).*$ /index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
