VITE_API_BASE_URL=http://localhost:4000
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=morya_prints
DB_BOOTSTRAP_MODE=full
# full   = create database if needed, then ensure schema
# schema = assume database already exists, only ensure tables/columns

ADMIN_EMAIL=admin@moryaprints.local
ADMIN_PASSWORD=set-a-secure-admin-password
# Optional stronger alternative to ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2a$10$...
JWT_SECRET=set-a-long-random-secret-at-least-32-characters

# Optional for split frontend/backend deployments:
# UPLOADS_PUBLIC_BASE_URL=https://api.example.com
